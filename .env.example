# API-only deployment needs no external credentials.
PORT=8082
BIND_ADDRESS=0.0.0.0
DEPLOY_TAG=local
MODEL_VERSION=m0-svd-v1
PROFILE_VOLUME_NAME=neural-network-smoke_smoke-profiles
# Local PostgreSQL settings. Use secret values outside local development.
POSTGRES_DB=recommender
POSTGRES_USER=recommender
POSTGRES_PASSWORD=recommender
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://recommender:recommender@database:5432/recommender
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_ECHO=false
# Fill these before enabling the live Compose profile. Keep .env out of Git.
USER_LOOKUP_URL_TEMPLATE=
USER_LIKES_FIELD=self_description_likes
USER_DISLIKES_FIELD=self_description_dislikes
USER_API_BEARER_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=
KAFKA_GROUP_ID=
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
COURSE_LOG_TIMEZONE=UTC
