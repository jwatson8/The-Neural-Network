# API-only deployment needs no external credentials.
PORT=8082
BIND_ADDRESS=0.0.0.0
DEPLOY_TAG=local
MODEL_VERSION=m0-svd-v1
# Local PostgreSQL settings. Use secret values outside local development.
POSTGRES_DB=recommender
POSTGRES_USER=recommender
# Required. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Required when enabling the monitoring profile.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_DB_PASSWORD=
# Fill these before enabling the live Compose profile. Keep .env out of Git.
USER_LOOKUP_URL_TEMPLATE=
USER_LIKES_FIELD=self_description_likes
USER_DISLIKES_FIELD=self_description_dislikes
USER_API_BEARER_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
KAFKA_SSH_PASSWORD=
# Paste the complete, independently verified known_hosts line as one quoted value.
KAFKA_SSH_KNOWN_HOSTS=""
KAFKA_TOPIC=movielog1
KAFKA_GROUP_ID=movielog1-recommender
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=students
KAFKA_SASL_PASSWORD=
COURSE_LOG_TIMEZONE=UTC
DAILY_MODEL_UPDATES_ENABLED=true
