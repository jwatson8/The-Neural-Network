# Copy to repository-root .env only if that file does not already exist.
# Replace placeholders before enabling live services. Do not commit .env.
BIND_ADDRESS=0.0.0.0
USER_LOOKUP_URL_TEMPLATE=http://REPLACE_COURSE_HOST:8080/user/{user_id}
USER_LIKES_FIELD=self_description_likes
USER_DISLIKES_FIELD=self_description_dislikes
OPENAI_API_KEY=REPLACE_ON_VM_WITH_AUTHORIZED_KEY
OPENAI_MODEL=gpt-4.1-mini
KAFKA_BOOTSTRAP_SERVERS=REPLACE_COURSE_HOST:9092
KAFKA_TOPIC=REPLACE_TEAM_TOPIC
KAFKA_GROUP_ID=REPLACE_UNIQUE_TEAM_GROUP_m1_live
# Confirm security settings with course instructions; do not assume PLAINTEXT.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Add KAFKA_SASL_MECHANISM, KAFKA_SASL_USERNAME, KAFKA_SASL_PASSWORD if required.
# Confirm the timezone for timestamps that have no explicit offset.
COURSE_LOG_TIMEZONE=UTC
