        "editorMode": "code",
        "format": "table",
        "rawQuery": true,
        "rawSql": "SELECT EXTRACT(EPOCH FROM (NOW() - MAX(generated_at)))::double precision AS \"Seconds since success\" FROM monitoring_runs",
